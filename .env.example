# Einstellungen über Umgebungsvariablen (z. B. in einer .env-Datei oder im System setzen)

# Session-Sicherheit – bitte eigenen zufälligen Wert setzen, z. B. mit: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=bitte-aendern

# SQLite-Datenbankdatei (Standard: urlaubsplanung.db im App-Ordner)
# DATABASE=/pfad/zu/urlaubsplanung.db

# SMTP für die Vertretungs-Mails (z. B. Gmail, Outlook, Firmen-Mailserver)
# Ohne SMTP_HOST wird die Mail nur im Server-Log ausgegeben (Testbetrieb).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_TLS=1
# SMTP_USER=urlaubsplanung@example.com
# SMTP_PASSWORD=super-geheim
# SMTP_FROM=urlaubsplanung@example.com
